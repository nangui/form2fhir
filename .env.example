# Required — server only, never exposed to the browser
ANTHROPIC_API_KEY=

# Optional (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
VALIDATOR_URL=https://hapi.fhir.org/baseR4
LOINC_SEARCH_URL=https://clinicaltables.nlm.nih.gov/api/loinc_items/v3/search

# Guardrails
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=100
MAX_TEXT_CHARS=20000
MAX_FILE_BYTES=3145728
MAX_PDF_PAGES=5

# Public
NUXT_PUBLIC_REPO_URL=https://github.com/nangui/form2fhir
